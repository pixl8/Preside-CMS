<?xml version="1.0" encoding="UTF-8"?>
<form i18nBaseUri="preside-objects.custom_field:">
	<tab id="default">
		<fieldset id="basics" sortorder="10">
			<field name="target_object" control="customFieldTargetObject" required="true" sortorder="10" />
			<field name="label"         control="textinput" required="true" sortorder="20" />
			<field name="key"           control="autoSlug" basedOn="label" slugDelimiter="_" required="true" sortorder="30" />
			<field name="kind"          control="customFieldKind" enum="customFieldKind" required="true" defaultValue="static" toggleFields="static:data_type|conditional_label:conditional_label_mode" filterBy="target_object" sortorder="40" />
			<field name="data_type"     control="enumRadioList" enum="customFieldDataType" defaultValue="text" sortorder="50" />
			<field name="conditional_label_mode" control="enumRadioList" enum="customFieldConditionalLabelMode" defaultValue="single" sortorder="60" />
		</fieldset>
	</tab>
</form>
