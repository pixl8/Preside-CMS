<?xml version="1.0" encoding="UTF-8"?>
<!--#!autodoc
User: edit profile form

This form is used for the "edit my profile" form
-->
<form>
	<tab id="basic" sortorder="10">
		<fieldset id="basic" sortorder="10">
			<field binding="security_user.email_address"          control="emailinput"           required="true" />
			<field binding="security_user.known_as" />
			<field binding="security_user.user_language"          control="localePicker"         adminLocales="true" />
			<field binding="security_user.user_admin_date_format" control="siteDateFormatPicker" dateFormatType="admin" />
			<field binding="security_user.user_time_format"       control="enumRadioList" />
			<field name="existing_password"                       control="password"             required="true" />
		</fieldset>
	</tab>
</form>