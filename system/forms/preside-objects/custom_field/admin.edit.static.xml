<?xml version="1.0" encoding="UTF-8"?>
<form i18nBaseUri="preside-objects.custom_field:">
	<tab id="default">
		<fieldset id="management" sortorder="20">
			<field binding="custom_field.batch_editable" control="yesNoSwitch" />
		</fieldset>
		<fieldset id="forms" sortorder="30">
			<field binding="custom_field.include_in_add_form"  control="yesNoSwitch"   sortorder="10" />
			<field binding="custom_field.include_in_edit_form" control="yesNoSwitch"   sortorder="20" />
			<field binding="custom_field.form_placement"       control="enumRadioList" enum="customFieldFormPlacement" defaultValue="auto" sortorder="30" toggleFields="manual:form_tab" />
			<field name="form_tab"            control="customFieldFormPlacement" sortorder="40" nolabel="true" />
			<field name="form_tab_label"      control="none" />
			<field name="form_fieldset"       control="none" />
			<field name="form_fieldset_label" control="none" />
		</fieldset>
	</tab>
</form>
