<?xml version="1.0" encoding="UTF-8"?>
<!--#!autodoc
Task manager: Settings form

This form is used for general configuration of the task manager
-->
<form i18nBaseUri="cms:taskmanager.configform." feature="taskmanager">
	<tab id="default">
		<fieldset id="default" sortorder="10">
			<field name="scheduledtasks_enabled" control="yesnoswitch"  required="false"             />
			<field name="keep_logs_for_days"     control="spinner"      required="false" default="7" />
			<field name="stuck_thread_period"    control="spinner"      required="false" default="1" minValue="1" maxValue="30" />
			<field name="site_context"           control="objectpicker" required="true" object="site" feature="sites" />
		</fieldset>
		<fieldset id="overrunalerts" sortorder="20">
			<field name="overrun_percentage"             control="spinner" sortorder="10" required="false" />
			<field name="overrun_previous_runs_required" control="spinner" sortorder="20" required="false" />
			<field name="overrun_minimum_runtime"        control="spinner" sortorder="30" required="false" />
		</fieldset>
	</tab>
</form>