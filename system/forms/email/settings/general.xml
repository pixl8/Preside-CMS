<?xml version="1.0" encoding="UTF-8"?>
<!--#!autodoc
Email center: General settings form

This form is used for configuring general email settings
-->
<form i18nBaseUri="cms:emailcenter.settings.general.form." feature="emailCenter">
	<tab id="default" sortorder="10">
		<fieldset id="default" sortorder="10">
			<field sortorder="10" name="default_from_address" control="textinput" required="false">
				<rule validator="allowedSenderEmail" />
			</field>
			<field sortorder="20" name="allowed_sending_domains" control="textarea" required="false" />
		</fieldset>
		<fieldset id="providers" sortorder="20">
			<field sortorder="10" name="defaultProvider"   control="emailServiceProviderPicker" addDefaultProvider="false" includeDisabledProviders="true" required="false" />
			<field sortorder="20" name="disabledProviders" control="emailServiceProviderPicker" addDefaultProvider="false" includeDisabledProviders="true" required="false" multiple="true" />
		</fieldset>
		<fieldset id="content" sortorder="30">
			<field sortorder="10" name="default_content_expiry"     control="spinner"     required="false" defaultValue="90" minValue="0" />
			<field sortorder="20" name="max_content_expiry"         control="spinner"     required="false" defaultValue="90" minValue="0" />
			<field sortorder="30" name="remove_view_online_content" control="yesnoswitch" required="false" />
			<field sortorder="40" name="view_online_content_expiry" control="spinner"     required="false" defaultValue="90" minValue="0" />
		</fieldset>
		<fieldset id="masssendout" sortorder="40">
			<field sortorder="10" name="ratelimit" control="spinner" required="false" default="100" />
		</fieldset>
		<fieldset id="features" sortorder="50">
			<field sortorder="10" name="resendtoken" control="yesnoswitch" required="false" default="false" />
		</fieldset>
		<fieldset id="clicktracking" sortorder="60">
			<field sortorder="10" name="disable_link_checking"   control="yesnoswitch" required="false" default="false" />
			<field sortorder="20" name="link_checking_allowlist" control="textarea" />
		</fieldset>
		<fieldset id="botdetection" sortorder="70" feature="emailTrackingBotDetection">
			<field sortorder="10" name="bot_score_threshold"            control="spinner"  required="false" defaultvalue="50"   minValue="1" maxValue="100" />
			<field sortorder="20" name="bot_weight_high"                control="spinner"  required="false" defaultvalue="50"   minValue="0" maxValue="100" />
			<field sortorder="30" name="bot_weight_medium"              control="spinner"  required="false" defaultvalue="25"   minValue="0" maxValue="100" />
			<field sortorder="40" name="bot_weight_low"                 control="spinner"  required="false" defaultvalue="10"   minValue="0" maxValue="100" />
			<field sortorder="50" name="bot_sweep_delay_seconds"        control="spinner"  required="false" defaultvalue="90"   minValue="1" />
			<field sortorder="60" name="bot_reclassify_window_seconds"  control="spinner"  required="false" defaultvalue="1800" minValue="1" />
			<field sortorder="70" name="bot_event_count_threshold"      control="spinner"  required="false" defaultvalue="6"    minValue="1" />
			<field sortorder="80" name="bot_distinct_link_threshold"    control="spinner"  required="false" defaultvalue="5"    minValue="1" />
			<field sortorder="90" name="bot_click_burst_count"          control="spinner"  required="false" defaultvalue="10"   minValue="1" />
			<field sortorder="100" name="bot_click_burst_seconds"       control="spinner"  required="false" defaultvalue="10"   minValue="1" />
			<field sortorder="110" name="bot_honeypot_window_seconds"   control="spinner"  required="false" defaultvalue="10"   minValue="1" />
			<field sortorder="120" name="bot_gateway_seconds"           control="spinner"  required="false" defaultvalue="5"    minValue="0" />
			<field sortorder="130" name="bot_scanner_user_agents"       control="textarea" required="false" defaultvalue="proofpoint&#10;mimecast&#10;barracuda&#10;safelinks&#10;antispam-agent&#10;skypeuripreview&#10;^mozilla/5\.0$" />
		</fieldset>
	</tab>
</form>