<?xml version="1.0" encoding="UTF-8"?>
<form i18nBaseUri="preside-objects.custom_field:">
	<tab id="default">
		<fieldset id="display" sortorder="40">
			<field name="booleanDisplay" control="enumRadioList" enum="customFieldBooleanDisplay" defaultValue="checkCross" sortorder="10" toggleFields="customBadge:trueLabel,trueColour,falseLabel,falseColour,unsetLabel,unsetColour" />
		</fieldset>
		<fieldset id="badge" sortorder="50">
			<field name="trueLabel"   control="textinput"          sortorder="10" maxLength="50" />
			<field name="trueColour"  control="simpleColourPicker" sortorder="20" colourFormat="hex" />
			<field name="falseLabel"  control="textinput"          sortorder="30" maxLength="50" />
			<field name="falseColour" control="simpleColourPicker" sortorder="40" colourFormat="hex" />
			<field name="unsetLabel"  control="textinput"          sortorder="50" maxLength="50" />
			<field name="unsetColour" control="simpleColourPicker" sortorder="60" colourFormat="hex" />
		</fieldset>
	</tab>
</form>
