<?xml version="1.0" encoding="UTF-8"?>
<!--#!autodoc
Admin datatable listing default: save form

Assign a saved listing view as Default for me, selected groups, or everyone.
-->
<form i18nBaseUri="preside-objects.admin_datatable_listing_default:">
	<tab id="default" sortorder="10">
		<fieldset id="audience" sortorder="10">
			<field name="scope" control="listingViewDefaultScope" required="true" defaultValue="individual" sortorder="10" />
		</fieldset>
		<fieldset id="group-filter" sortorder="20">
			<field name="user_groups" control="objectPicker" object="security_group" multiple="true" objectFilters="myAdminGroups" sortorder="10" />
		</fieldset>
	</tab>
</form>
